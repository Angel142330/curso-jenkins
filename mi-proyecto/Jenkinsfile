// Cargar la Shared Library desde la raíz del repositorio
@Library('jenkins-shared-library@develop') _

pipeline {
    agent any 
    
    stages {
        stage('Build') {
            steps {
                // Usando buildMaven de vars/buildMaven.groovy
                buildMaven('mi-proyecto')
            }
        }
        
        stage('Test') {
            steps {
                // Usando testMaven de vars/testMaven.groovy
                testMaven('mi-proyecto')
            }
        }
        
        stage('Deploy') {
            steps {
                // Usando deployApp de vars/deployApp.groovy
                deployApp(
                    appName: 'mi-proyecto',
                    environment: 'development',
                    deployCommand: 'echo "Simulando despliegue en el servidor de producción"'
                )
            }
        }
    }

    post {
        always {
            echo 'Pipeline finalizado'
        }
        success {
            // Usando notifySlack de vars/notifySlack.groovy
            notifySlack('Build completado exitosamente!', 'SUCCESS')
        }
        failure {
            // Usando notifySlack de vars/notifySlack.groovy
            notifySlack('Build falló', 'FAILURE')
        }
    }
}