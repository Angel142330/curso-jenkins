// Cargar la Shared Library desde la raíz del repositorio
@Library('jenkins-shared-library@develop') _
import org.miempresa.Utils  // ← Importar la clase Utils

def utils = new Utils(this)  // ← Crear instancia de Utils

pipeline {
    agent any 
    
    environment {
        BUILD_VERSION = ''      
        BUILD_TIMESTAMP = ''
        IS_RELEASE_BRANCH = ''  
    }
    
    stages {
        stage('Prepare - Info Build') {
            steps {
                script {
                    // ✨ USANDO UTILS para obtener información
                    BUILD_TIMESTAMP = utils.getTimestamp('yyyyMMdd-HHmmss')
                    BUILD_VERSION = utils.getTimestamp('yyyyMMdd')
                    IS_RELEASE_BRANCH = utils.isReleaseBranch(env.BRANCH_NAME ?: 'develop')
                    
                    echo "════════════════════════════════════════"
                    echo " INFORMACIÓN DEL BUILD"
                    echo "════════════════════════════════════════"
                    echo "  Build Version: ${BUILD_VERSION}"
                    echo "  Build Timestamp: ${BUILD_TIMESTAMP}"
                    echo "  Rama: ${env.BRANCH_NAME ?: 'develop'}"
                    echo "  Release Branch: ${IS_RELEASE_BRANCH}"
                    echo "  Build Number: ${env.BUILD_NUMBER}"
                    echo "  Started by: ${env.BUILD_USER_ID ?: 'Jenkins'}"
                    echo "════════════════════════════════════════"
                }
            }
        }
        
        stage('Build') {
            steps {
                // Usando buildMaven de vars/buildMaven.groovy
                buildMaven('mi-proyecto')
            }
        }
        
        stage('Test') {
            steps {
                // Usando testMaven de vars/testMaven.groovy
                testMaven('mi-proyecto')
            }
        }
        
        stage('Deploy') {
            steps {
                script {
                    // Determinar entorno según el tipo de rama (usando Utils)
                    def environment = IS_RELEASE_BRANCH ? 'staging' : 'development'
                    
                    echo "🎯 Desplegando a: ${environment} (Branch: ${IS_RELEASE_BRANCH})"
                    
                    // Usando deployApp de vars/deployApp.groovy
                    deployApp(
                        appName: "mi-proyecto-${BUILD_VERSION}",  // ← Usando versión de Utils
                        environment: environment,
                        deployCommand: "echo 'Desplegando versión ${BUILD_TIMESTAMP} a ${environment}'"
                    )
                }
            }
        }
    }

    post {
        always {
            script {
                echo '════════════════════════════════════════'
                echo '📊 RESUMEN DEL BUILD'
                echo '════════════════════════════════════════'
                echo "Version: ${BUILD_VERSION}"
                echo "Timestamp: ${BUILD_TIMESTAMP}"
                echo "Status: ${currentBuild.currentResult}"
                echo 'Pipeline finalizado'
                echo '════════════════════════════════════════'
            }
        }
        success {
            script {
                // Usando notifySlack con información de Utils
                notifySlack("Build ${BUILD_VERSION} completado exitosamente! 🎉", 'SUCCESS')
            }
        }
        failure {
            script {
                // Usando notifySlack con información de Utils
                notifySlack("Build ${BUILD_VERSION} falló en ${env.STAGE_NAME} ❌", 'FAILURE')
            }
        }
    }
}