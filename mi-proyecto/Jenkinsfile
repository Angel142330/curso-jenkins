pipeline {
    agent any 
    stages{
        stage('Build'){
            steps{
                dir('mi-proyecto') {
                    sh 'mvn clean install'
                }
            }
        }
        stage('Test'){
            steps{
                dir('mi-proyecto') {
                    sh 'mvn test'
                }
            }
        }
        stage('Deploy'){
            steps{
                echo 'Simulando despliegue en el servidor de producción'
            }
        }
    }

    post{
        always{
            echo 'Always'
        }
        success{
            echo 'Este es el success'
        }
        failure{
            echo 'Este es el failure'
        }
        
    }
    
}